{
  "hooks": {},

  // compact対策。圧縮の直前に状態を書き出し、圧縮後の最初の注入点で読み直しを指示する。
  // PostCompactは追加コンテキストを返せないため、SessionStartを主経路、UserPromptSubmitを
  // フォールバックとする。2つのイベントの配送順は配布先で逆になるため、markerと注入済み印を
  // 相互に見て、どちらの順でも注入がちょうど一度になるようにしている。
  // スクリプトはrulesyncが運ばない。scripts/apply.ps1が ~/.agent-source/hooks/ へ配る。
  // Antigravityはこれらのイベントを持たないため、配布しない。
  "claudecode": {
    "hooks": {
      "preCompact": [
        { "type": "command", "command": "node ~/.agent-source/hooks/compact-hook.mjs save" }
      ],
      "postCompact": [
        { "type": "command", "command": "node ~/.agent-source/hooks/compact-hook.mjs mark" }
      ],
      "sessionStart": [
        { "type": "command", "matcher": "compact", "command": "node ~/.agent-source/hooks/compact-hook.mjs restore" }
      ],
      "beforeSubmitPrompt": [
        { "type": "command", "command": "node ~/.agent-source/hooks/compact-hook.mjs inject" }
      ]
    }
  },
  // Windows 版 Codex は hook を PowerShell（取得できない場合は cmd.exe）で実行し、`~` を展開しない。
  // 環境変数の参照構文はシェルごとに異なるため、commandWindows ではnodeがos.homedir()からスクリプトを
  // 解決し、argv[1]へ補ってからimportする。シェルが解釈する`$`や`%`を含めず、どちらのシェルでも同じ文字列で動く。
  // Claude Code は自身が解決した Git Bash で実行するため、commandWindows を定義しない。
  "codexcli": {
    "hooks": {
      "preCompact": [
        {
          "type": "command",
          "command": "node ~/.agent-source/hooks/compact-hook.mjs save",
          "commandWindows": "node -e \"const p=require('path').join(require('os').homedir(),'.agent-source','hooks','compact-hook.mjs');process.argv.splice(1,0,p);import(require('url').pathToFileURL(p).href)\" save"
        }
      ],
      "postCompact": [
        {
          "type": "command",
          "command": "node ~/.agent-source/hooks/compact-hook.mjs mark",
          "commandWindows": "node -e \"const p=require('path').join(require('os').homedir(),'.agent-source','hooks','compact-hook.mjs');process.argv.splice(1,0,p);import(require('url').pathToFileURL(p).href)\" mark"
        }
      ],
      "sessionStart": [
        {
          "type": "command",
          "matcher": "compact",
          "command": "node ~/.agent-source/hooks/compact-hook.mjs restore",
          "commandWindows": "node -e \"const p=require('path').join(require('os').homedir(),'.agent-source','hooks','compact-hook.mjs');process.argv.splice(1,0,p);import(require('url').pathToFileURL(p).href)\" restore"
        }
      ],
      "beforeSubmitPrompt": [
        {
          "type": "command",
          "command": "node ~/.agent-source/hooks/compact-hook.mjs inject",
          "commandWindows": "node -e \"const p=require('path').join(require('os').homedir(),'.agent-source','hooks','compact-hook.mjs');process.argv.splice(1,0,p);import(require('url').pathToFileURL(p).href)\" inject"
        }
      ]
    }
  }
}
