{
  "hooks": {},

  // compact対策。圧縮の直前に状態を書き出し、圧縮後の最初の注入点で読み直しを指示する。
  // PostCompactは追加コンテキストを返せないため、SessionStartを主経路、UserPromptSubmitを
  // フォールバックとする。2つのイベントの配送順は配布先で逆になるため、markerと注入済み印を
  // 相互に見て、どちらの順でも注入がちょうど一度になるようにしている。
  // スクリプトはrulesyncが運ばない。scripts/apply.ps1が ~/.agent-source/hooks/ へ配る。
  // Antigravityはこれらのイベントを持たないため、配布しない。
  "claudecode": {
    "hooks": {
      "preCompact": [
        { "type": "command", "command": "node ~/.agent-source/hooks/compact-hook.mjs save" }
      ],
      "postCompact": [
        { "type": "command", "command": "node ~/.agent-source/hooks/compact-hook.mjs mark" }
      ],
      "sessionStart": [
        { "type": "command", "matcher": "compact", "command": "node ~/.agent-source/hooks/compact-hook.mjs restore" }
      ],
      "beforeSubmitPrompt": [
        { "type": "command", "command": "node ~/.agent-source/hooks/compact-hook.mjs inject" }
      ]
    }
  },
  // Windows 版 Codex は hook を PowerShell（取得できない場合は cmd.exe）で実行し、`~` を展開しない。
  // PowerShell の実行に合わせ、commandWindows で USERPROFILE からスクリプトを解決する。
  // Claude Code は自身が解決した Git Bash で実行するため、commandWindows を定義しない。
  "codexcli": {
    "hooks": {
      "preCompact": [
        {
          "type": "command",
          "command": "node ~/.agent-source/hooks/compact-hook.mjs save",
          "commandWindows": "node \"$env:USERPROFILE\\.agent-source\\hooks\\compact-hook.mjs\" save"
        }
      ],
      "postCompact": [
        {
          "type": "command",
          "command": "node ~/.agent-source/hooks/compact-hook.mjs mark",
          "commandWindows": "node \"$env:USERPROFILE\\.agent-source\\hooks\\compact-hook.mjs\" mark"
        }
      ],
      "sessionStart": [
        {
          "type": "command",
          "matcher": "compact",
          "command": "node ~/.agent-source/hooks/compact-hook.mjs restore",
          "commandWindows": "node \"$env:USERPROFILE\\.agent-source\\hooks\\compact-hook.mjs\" restore"
        }
      ],
      "beforeSubmitPrompt": [
        {
          "type": "command",
          "command": "node ~/.agent-source/hooks/compact-hook.mjs inject",
          "commandWindows": "node \"$env:USERPROFILE\\.agent-source\\hooks\\compact-hook.mjs\" inject"
        }
      ]
    }
  }
}
